# ============================================================================
#  Alertas Oficiales — Variables de entorno (copiar a .env y rellenar)
# ============================================================================

# --- Identidad del prestador del servicio (aparece en avisos legales) ---
PROVIDER_NAME="Jaume Insa Pérez"
PROVIDER_NIF="21693936Z"
PROVIDER_EMAIL="contacto@tudominio.es"
PROVIDER_PHONE=""
PROVIDER_ADDRESS="Dirección profesional, España"
SITE_NAME="Alertas Oficiales"
SITE_URL="https://tudominio.es"

# --- Aplicación ---
SECRET_KEY="cambia-esto-por-una-cadena-larga-y-aleatoria"
DEBUG=false
# Precio mostrado en la web (informativo). El precio real lo fija Stripe.
PRICE_EUR="5"

# --- Base de datos ---
# En docker-compose se usa el host "db". En local: localhost.
DATABASE_URL="postgresql+psycopg2://alertas:alertas@db:5432/alertas"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# ID del precio recurrente (5 €/mes) creado en el panel de Stripe.
STRIPE_PRICE_ID="price_..."

# --- Email (SMTP) ---
SMTP_HOST="smtp.tudominio.es"
SMTP_PORT=587
SMTP_USER="alertas@tudominio.es"
SMTP_PASSWORD=""
SMTP_FROM="Alertas Oficiales <alertas@tudominio.es>"
SMTP_STARTTLS=true

# --- Ingesta de boletines ---
# Fecha de inicio del histórico al hacer backfill (AAAA-MM-DD).
# La API de datos abiertos del BOE cubre con fiabilidad desde ~2010 (BOE-A).
INGEST_START_DATE="2010-01-01"
# Petición educada: pausa (segundos) entre llamadas a boe.es
INGEST_REQUEST_DELAY="0.4"
# Hora diaria (UTC) para la ingesta automática del día
INGEST_DAILY_HOUR=6
