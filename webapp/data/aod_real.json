    "casos": [
      {
        "anio": 2024,
        "titulo": "FONPRODE 2024: cartera viva de 572,7 M EUR y debilidades de seguimiento individualizado de operaciones senaladas por la AIReF",
        "fuente": "https://www.airef.es/es/estudios-observatorio/cooperacion-financiera-fonprode/",
        "resumen": "En 2024 el FONPRODE autorizo operaciones por 210 M EUR (58,6 M EUR desembolsados) con una cartera viva al cierre de 572,7 M EUR. La AIReF detecto que el seguimiento de las operaciones es insuficiente: el control semestral se limita a criterios de solvencia y no al destino individualizado de los fondos prestados, lo que motivo reformas en el nuevo FEDES."
      },
      {
        "anio": 2023,
        "titulo": "Tribunal de Cuentas: Informe de Fiscalizacion de los contratos de la AECID, ejercicio 2023 (Informe N.o 1.629, aprobado el 28-07-2025)",
        "fuente": "https://www.tcu.es/repositorio/90abd01a-809e-454c-ad96-a501eebb7edc/I1629.pdf",
        "resumen": "El Tribunal de Cuentas fiscalizo la contratacion de la AECID en 2023 y detecto bajisima ejecucion presupuestaria (de 7.469.533 EUR presupuestados solo se ejecutaron 1.580.056,36 EUR), incumplimientos de plazos de publicidad y debilidades de planificacion y gestion contractual."
      },
      {
        "anio": 2023,
        "titulo": "Tribunal de Cuentas: diligencias por presunta responsabilidad contable en la AECID por 21,7 M EUR en pagos sin justificacion documental (indicios concentrados en 2023)",
        "fuente": "https://spanish.news-pravda.com/spain/2025/12/28/702105.html",
        "resumen": "El Tribunal de Cuentas abrio una investigacion (designando delegada instructora) por sospecha de responsabilidad contable en la AECID, con foco en 21,7 millones de euros en pagos sin la debida justificacion documental, irregularidades concentradas en el ejercicio 2023 (algunos desajustes arrastrados desde 2016)."
      },
      {
        "anio": 2022,
        "titulo": "El Tribunal de Cuentas detecta irregularidades en contratos de Politica exterior y cooperacion para el desarrollo (ejercicio 2022), 8 de ellos adjudicados por la AECID",
        "fuente": "https://www.tcu.es/en/sala-de-prensa/noticias/Aprobado-el-Informe-de-Fiscalizacion-de-los-Contratos-de-la-Administracion-General-del-Estado-vinculados-a-las-politicas-de-gasto-11-Justicia-12-Defensa-y-14-Politica-exterior-y-cooperacion-para-el-desarrollo-ejercicio-2022/",
        "resumen": "Informe de fiscalizacion de los contratos de la AGE en politica exterior y cooperacion (ejercicio 2022, aprobado el 29/07/2025): de 103 contratos por 363 M EUR, detecto irregularidades en 16 del area de Exteriores/cooperacion, de los que 8 fueron adjudicados por la AECID (falta de planificacion, controles de ejecucion insuficientes, uso indebido de la experiencia como criterio, vulneracion del art. 100.2 LCSP). Caso mas grave: proyecto Subatra en Filipinas."
      },
      {
        "anio": 2022,
        "titulo": "AIReF evalua la cooperacion financiera reembolsable (FONPRODE) y detecta debilidades de planificacion y gestion (Estudio, diciembre 2022)",
        "fuente": "https://www.airef.es/wp-content/uploads/2022/12/FONPRODE/ESTUDIO-COOPERACIO%CC%81N-FINANCIERA-FONPRODE.pdf",
        "resumen": "Estudio de la AIReF sobre el FONPRODE (publicado en diciembre de 2022): concluye que la cooperacion financiera reembolsable espanola es muy reducida frente a su entorno, con procedimientos excesivamente fragmentados, multiples agentes y escasez de capital humano especializado. Formula propuestas para mejorar la planificacion y gobernanza del instrumento."
      },
      {
        "anio": 2021,
        "titulo": "Tribunal de Cuentas: incumplimientos en contratacion, personal, transparencia e igualdad en la FIIAPP (ejercicios 2020-2021)",
        "fuente": "https://www.tcu.es/es/sala-de-prensa/noticias/El-Tribunal-de-Cuentas-recomienda-a-la-FIIAPP-intensificar-los-controles-en-los-contratos/",
        "resumen": "Informe N.o 1.540 del Tribunal de Cuentas (aprobado en noviembre de 2023) sobre la FIIAPP, fundacion estatal de cooperacion tecnica. En 2020-2021 formalizo 349 contratos por 83 M EUR mas 455 contratos menores; el Tribunal detecto incumplimientos de la normativa de contratos (fraccionamientos indebidos, falta de acreditacion de solvencia), exceso de personal temporal, debil control interno y retrasos en la rendicion de cuentas."
      },
      {
        "anio": 2021,
        "titulo": "FIIAPP figuraba en contratos/pagos a agentes de la UDEF vinculados a la 'operacion Cataluna' (cuentas 2020-2021 fiscalizadas)",
        "fuente": "https://elmon.cat/es/politica-es/tribunales/una-fundacion-publica-pagaba-a-policias-relacionados-con-la-operacion-catalunya-975870/",
        "resumen": "A raiz del informe del Tribunal de Cuentas sobre las cuentas 2020-2021 de la FIIAPP, la prensa documento que en sus cuentas figuraban contratos y pagos a agentes de la UDEF relacionados con la 'operacion Cataluna'. Un ataque ransomware de abril de 2023 provoco ademas la perdida de la contabilidad de 2020-2022, reconstruida solo parcialmente."
      },
      {
        "anio": 2021,
        "titulo": "OLAF (UE) investiga desvio de fondos de cooperacion gestionados por la AECID en Bolivia (programas de agua), con comisiones/sobornos 2021-2023",
        "fuente": "https://eldeber.com.bo/pais/union-europea-investiga-desvio-cooperacion-debia-servir-dotar-agua_1763951035",
        "resumen": "La OLAF investiga el presunto desvio de fondos de cooperacion canalizados via dos convenios de delegacion UE con la AECID en Bolivia (agua y alcantarillado). Una testigo declaro haber cobrado comisiones del 3% sobre contratos direccionados por el Ministerio boliviano de Medio Ambiente y Agua entre 2021 y 2023, con presuntos sobornos a un exministro."
      },
      {
        "anio": 2022,
        "titulo": "AIReF (Spending Review 2022-2026, Fase 2): 6.000 M EUR de AOD ejecutados fuera de la gestion directa del Gobierno",
        "fuente": "https://www.airef.es/wp-content/uploads/2026/02/SpendingReview-2022-2026-fase-2/SR2226F2_AOD.pdf",
        "resumen": "Estudio de la AIReF sobre AOD (Spending Review 2022-2026, fase 2): sobre 10.847 M EUR desembolsados en 2021-2023, el 55,7% (unos 6.000 M EUR) se canalizo via organismos multilaterales con sistemas propios, fuera de la gestion directa del Gobierno, lo que reduce la visibilidad administrativa, dificulta el seguimiento del gasto e impide indicadores de impacto comparables. No es fraude penal sino debilidad de control."
      },
      {
        "anio": 2016,
        "titulo": "Tribunal de Cuentas: irregularidades y salvedades en el FONPRODE (ejercicios 2012-2013)",
        "fuente": "https://www.tcu.es/gl/sala-de-prensa/noticias/APROBADO-EL-INFORME-SOBRE-EL-FONDO-PARA-LA-PROMOCION-DEL-DESARROLLO-FONPRODE-EJERCICIOS-2012-Y-2013/",
        "resumen": "Informe del Tribunal de Cuentas sobre el FONPRODE (ejercicios 2012-2013, aprobado el 12/07/2016): constato prestamos a fondos domiciliados en paraisos fiscales (Islas Caiman gestionado desde Panama, Mauricio), incumplimiento del art. 14 de la ley del FONPRODE y ausencia de seguimiento individualizado de prestatarios de segundo nivel. Antecedente recurrente de las salvedades sobre el instrumento."
      },
      {
        "anio": 2016,
        "titulo": "Tribunal de Cuentas (Informe num. 1.317): 'agujero' de mas de 2.000 M EUR en subvenciones de AOD gestionadas por la AECID por prescripcion del derecho de reintegro",
        "fuente": "https://www.tcu.es/repositorio/18c1b8f4-8faf-41f9-a575-16d314c356bd/I1317.pdf",
        "resumen": "Informe de fiscalizacion de las subvenciones de AOD gestionadas por la AECID (ejercicio 2016, aprobado en marzo de 2019). El Tribunal aforo 2.038.655.925 EUR de subvenciones (concedidas 2001-2011) cuyo derecho de reintegro habia prescrito, con 4.005 expedientes sin actuaciones que interrumpieran la prescripcion y falta de sistemas uniformes de seguimiento hasta 2011."
      }
